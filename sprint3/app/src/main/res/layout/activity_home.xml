<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary"
    android:fillViewport="true"
    tools:context=".HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Imagen Principal con ShapeableImageView para bordes inferiores redondeados -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVeladaBanner"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:contentDescription="@string/cd_velada_banner"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/BottomRoundedImage"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Capa de degradado para transición visual limpia (decorativa, ignorada por TalkBack) -->
        <View
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_image_gradient"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/ivVeladaBanner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Etiqueta personalizada usando el shape bg_badge_shape.xml -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge_shape"
            android:letterSpacing="0.08"
            android:text="@string/velada_badge"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivVeladaBanner" />

        <!-- Título Principal -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/velada_title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBadge" />

        <!-- Subtítulo / Descripción -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/velada_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Botón de Acción Principal (CTA) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:minHeight="56dp"
            android:text="@string/btn_buy_tickets"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_gold"
            app:cornerRadius="14dp"
            app:elevation="4dp"
            app:icon="@android:drawable/ic_menu_my_calendar"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/bg_dark_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintVertical_bias="1.0"
            app:rippleColor="@color/accent_gold_dark" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>